{
  "name": "@wpptrack/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch -r ts-node/register src/main.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prebuild": "pnpm run prisma:generate",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "gupshup:ctwa-audit": "node dist/apps/api/src/scripts/audit-gupshup-ctwa.js",
    "payt:value-backfill": "node dist/src/scripts/backfill-payt-sale-value.js",
    "platform-admin:create": "node dist/src/scripts/create-platform-admin.js",
    "platform-owner:promote": "node dist/apps/api/src/scripts/promote-platform-owner.js",
    "create-user": "ts-node --project tsconfig.json src/scripts/create-user.ts",
    "test": "vitest run",
    "test:compiled-di": "pnpm build && vitest run --config vitest.compiled-di.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "pnpm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^6.19.3",
    "@wpptrack/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "body-parser": "1.20.4",
    "bullmq": "^5.79.2",
    "exceljs": "4.4.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.14.5",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}

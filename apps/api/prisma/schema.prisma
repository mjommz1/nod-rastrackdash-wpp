generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum PlatformRole {
  platform_owner
  platform_operator
}

enum AuthProvider {
  email
  google
}

enum WorkspaceInviteStatus {
  pending
  sent
  failed
  accepted
  revoked
  expired
}

enum WorkspaceOperationalStatus {
  active
  blocked
}

enum WhatsappInstanceStatus {
  pending_payment
  active
  disconnected
  suspended
  error
}

enum DiagnosticSource {
  kommo
  meta
  uazapi
  umbler
  gupshup
  asaas
  external_mysql
  internal
  waha
  zapi
  data_crazy
  payt
  unnichat
}

enum DiagnosticSeverity {
  info
  warning
  error
  critical
}

enum PaymentChargeStatus {
  pending
  paid
  failed
  canceled
  expired
}

enum WhatsappInstanceActivationStatus {
  pending_payment
  active
  canceled
  expired
}

enum SubscriptionPlanKind {
  standard
  custom
  exempt
  legacy_protected
}

enum SubscriptionPlanVisibility {
  public
  private
}

enum WorkspaceSubscriptionContractStatus {
  draft
  awaiting_payment
  active
  past_due
  grace_period
  cancel_at_period_end
  suspended
  canceled
  exempt
  legacy_protected
}

enum SubscriptionPaymentMethod {
  unknown
  credit_card
  pix
}

enum WorkspaceBillingProfileStatus {
  incomplete
  valid
  invalid
}

enum WhatsappSeatStatus {
  reserved
  active
  suspended
  released
}

enum WhatsappSeatProvider {
  uazapi
  cloud_api
  umbler
  gupshup
}

enum BillingProviderEventStatus {
  received
  processing
  processed
  ignored
  failed
}

enum BillingInvoiceStatus {
  not_configured
  pending_configuration
  scheduled
  issued
  authorized
  canceled
  failed
  rejected
}

enum ConversionTriggerType {
  keyword
  whatsapp_label
  provider_automation
  message_phrase
  structured_catalog
}

enum ConversionMatchMode {
  contains
  exact
}

enum ProviderConversionRuleMode {
  observation
  production
}

/// Alcance de uma regra de conversao por provedor. "specific_numbers" e o
/// comportamento historico (canais escolhidos em ProviderConversionRuleChannel);
/// "all_numbers" avalia dinamicamente todo numero do workspace que suporte a
/// origem da regra, inclusive numeros conectados depois. Uma regra especifica
/// do mesmo evento/origem substitui a global naquele numero.
enum ProviderConversionRuleScope {
  all_numbers
  specific_numbers
}

enum ProviderConversionEngineMode {
  legacy
  shadow
  canonical
}

enum ProviderConversionMessageAuthorScope {
  team
  contact
  both
}

enum ProviderConversionExecutionStatus {
  observed
  eligible
  materialized
  duplicate
  blocked
  failed
}

enum PurchaseReviewStatus {
  recognized
  awaiting_data
  review_required
  approved
  sent
  duplicate
  rejected
  failed
  corrected_after_send
}

enum PurchaseReviewSourceType {
  provider_message
  provider_automation
}

enum LeadStatus {
  new
  active
  qualified
  converted
  lost
}

enum MetaAssetSyncStatus {
  pending
  syncing
  synced
  error
}

enum MetaConversionDestinationStatus {
  needs_configuration
  configured
  error
}

enum MetaCredentialSource {
  oauth
  manual
}

enum MetaCredentialStatus {
  pending
  active
  validation_required
  expired
  revoked
  error
  paused
}

enum MetaBusinessConnectionStatus {
  pending
  active
  validation_required
  token_expired
  missing_permission
  destination_invalid
  error
  paused
}

enum MetaWhatsappClassification {
  auto_whatsapp
  creative_whatsapp
  detected_by_leads
  manual_include
  manual_exclude
  needs_review
  not_whatsapp
}

enum MetaAdDestinationAssignmentSource {
  automatic
  manual
}

enum AuthActionTokenType {
  password_reset
  email_verification
  account_activation
}

enum InboundWebhookProvider {
  umbler
  gupshup
  uazapi
  meta_cloud
  data_crazy
  payt
  unnichat
}

enum InboundWebhookParserReleaseStatus {
  observation_only
  certified
  retired
}

enum InboundWebhookConnectionStatus {
  observation
  production
  paused
}

enum InboundWebhookChannelStatus {
  discovered
  active
  paused
}

enum InboundWebhookMetaRoutingMode {
  inherit_workspace
  channel_override
}

enum InboundWebhookDeliveryStatus {
  pending
  queued
  processing
  processed
  failed
}

enum InboundWebhookDeliveryPurpose {
  message_observation
  conversion_automation
}

enum InboundWebhookEventClassification {
  eligible_route_resolved
  eligible_route_unresolved
  ignored_no_ctwa
  ignored_outbound
  ignored_private
  ignored_empty_template
  ignored_untracked_lead
  unsupported_event
  invalid_payload
}

enum InboundWebhookReplayStatus {
  queued
  processing
  completed
  completed_with_failures
  failed
}

enum InboundWebhookReplayItemStatus {
  queued
  processing
  materialized
  duplicate
  skipped
  failed
}

enum InboundWebhookProductionItemStatus {
  queued
  processing
  materialized
  duplicate
  failed
}

enum InboundWebhookReplaySelection {
  canary_1
  canary_5
  canary_10
  remaining
}

/// Moedas suportadas nas conversões e na correção por conta de anúncio.
enum CurrencyCode {
  BRL
  USD
  EUR
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  passwordHash    String?
  authProvider    AuthProvider  @default(email)
  googleId        String?       @unique
  emailVerifiedAt DateTime?
  platformRole    PlatformRole?
  lastWorkspaceId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships                      WorkspaceMember[]
  sessions                         AuthSession[]
  actionTokens                     AuthActionToken[]
  lastWorkspace                    Workspace?                        @relation("UserLastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
  auditLogs                        AuditLog[]
  createdMetaCredentials           MetaCredential[]                  @relation("MetaCredentialCreator")
  createdMetaBusinessConnections   MetaBusinessConnection[]          @relation("MetaBusinessConnectionCreator")
  createdMetaDestinations          MetaConversionDestination[]       @relation("MetaConversionDestinationCreator")
  createdMetaAccountDestinations   MetaReportingAccountDestination[] @relation("MetaReportingAccountDestinationCreator")
  createdMetaAdAssignments         MetaAdDestinationAssignment[]     @relation("MetaAdDestinationAssignmentCreator")
  certifiedInboundWebhookParsers   InboundWebhookParserRelease[]     @relation("InboundWebhookParserReleaseCertifier")
  createdInboundWebhookConnections InboundWebhookConnection[]        @relation("InboundWebhookConnectionCreator")
  createdInboundWebhookRoutes      InboundWebhookChannelRoute[]      @relation("InboundWebhookChannelRouteCreator")
  requestedInboundWebhookReplays   InboundWebhookReplayBatch[]       @relation("InboundWebhookReplayRequester")
  createdProviderConversionRules   ProviderConversionRuleConfig[]    @relation("ProviderConversionRuleCreator")
  decidedPurchaseReviews           PurchaseReview[]                  @relation("PurchaseReviewDecisionActor")
  purchaseValueAdjustments         PurchaseValueAdjustment[]         @relation("PurchaseValueAdjustmentActor")
  createdIntegrationEndpoints      IntegrationEndpoint[]             @relation("IntegrationEndpointCreator")

  @@index([lastWorkspaceId])
}

model Workspace {
  id                 String                     @id @default(cuid())
  name               String
  slug               String                     @unique
  asaasCustomerId    String?
  operationalStatus  WorkspaceOperationalStatus @default(active)
  /// "Moeda das conversões": padrão quando a venda e a regra não informam moeda.
  conversionCurrency CurrencyCode               @default(BRL)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  members                          WorkspaceMember[]
  invites                          WorkspaceInvite[]
  whatsappInstances                WhatsappInstance[]
  uazapiChatLabelStates            UazapiChatLabelState[]
  diagnosticEvents                 DiagnosticEvent[]
  webhookLogs                      WebhookLog[]
  integrationLogs                  IntegrationLog[]
  conversionEventLogs              ConversionEventLog[]
  jobAttempts                      JobAttempt[]
  auditLogs                        AuditLog[]
  conversionRules                  ConversionRule[]
  funnelStageConfigurations        FunnelStageConfiguration[]
  leads                            Lead[]
  metaIntegration                  MetaIntegration?
  metaCredentials                  MetaCredential[]
  metaBusinessConnections          MetaBusinessConnection[]
  metaAssetSnapshots               MetaAssetSnapshot[]
  metaConversionDestinations       MetaConversionDestination[]
  metaReportingAccounts            MetaReportingAccount[]
  metaReportingAccountDestinations MetaReportingAccountDestination[]
  metaAdDestinationAssignments     MetaAdDestinationAssignment[]
  metaCampaigns                    MetaCampaign[]
  metaCampaignDailyInsights        MetaCampaignDailyInsight[]
  metaAdSets                       MetaAdSet[]
  metaAdSetDailyInsights           MetaAdSetDailyInsight[]
  metaAds                          MetaAd[]
  metaAdDailyInsights              MetaAdDailyInsight[]
  externalDataConnectors           ExternalDataConnector[]
  externalIngestionRecords         ExternalIngestionRecord[]
  activeSessions                   AuthSession[]                        @relation("AuthSessionActiveWorkspace")
  supportSessions                  AuthSession[]                        @relation("AuthSessionSupportWorkspace")
  lastSelectedByUsers              User[]                               @relation("UserLastWorkspace")
  actionTokens                     AuthActionToken[]
  inboundWebhookConnections        InboundWebhookConnection[]
  inboundWebhookChannels           InboundWebhookChannel[]
  inboundWebhookChannelRoutes      InboundWebhookChannelRoute[]
  inboundWebhookDeliveries         InboundWebhookDelivery[]
  inboundWebhookEvents             InboundWebhookEvent[]
  inboundWebhookReplayBatches      InboundWebhookReplayBatch[]
  inboundWebhookReplayItems        InboundWebhookReplayItem[]
  inboundWebhookProductionItems    InboundWebhookProductionItem[]
  providerConversionRules          ProviderConversionRuleConfig[]
  providerConversionRuleChannels   ProviderConversionRuleChannel[]
  providerConversionRuleEndpoints  ProviderConversionRuleEndpoint[]
  integrationEndpoints             IntegrationEndpoint[]
  integrationEndpointEvents        IntegrationEndpointEvent[]
  providerRuleCreateClaims         ProviderRuleCreateClaim[]
  providerPurchaseClaims           ProviderPurchaseClaim[]
  providerConversionExecutions     ProviderConversionRuleExecution[]
  providerConversionDecisions      ProviderConversionDecisionAudit[]
  providerConversionComparisons    ProviderConversionShadowComparison[]
  conversionCatalogs               ConversionCatalog[]
  conversionCatalogAttributes      ConversionCatalogAttribute[]
  conversionCatalogVariants        ConversionCatalogVariant[]
  purchaseReviews                  PurchaseReview[]
  purchaseReviewItems              PurchaseReviewItem[]
  purchaseValueAdjustments         PurchaseValueAdjustment[]
  kommoConnections                 KommoConnection[]
  kommoPipelineCatalog             KommoPipelineCatalog[]
  kommoConversionRules             KommoConversionRule[]
  kommoWebhookEvents               KommoWebhookEvent[]
  kommoConversionDedupes           KommoConversionDedupe[]
  pipedriveConnections             PipedriveConnection[]
  pipedrivePipelineCatalog         PipedrivePipelineCatalog[]
  pipedriveStageCatalog            PipedriveStageCatalog[]
  pipedriveConversionRules         PipedriveConversionRule[]
  pipedriveWebhookEvents           PipedriveWebhookEvent[]
  pipedriveConversionDedupes       PipedriveConversionDedupe[]
  opsAlertSettings                 WorkspaceOpsAlertSettings?
  opsAlertDeliveries               WorkspaceOpsAlertDelivery[]

  @@index([asaasCustomerId])
  @@index([operationalStatus])
}

model WorkspaceOpsAlertSettings {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  enabled               Boolean  @default(false)
  alertPhonesE164       String[] @default([])
  alertPhoneE164        String?
  disconnectAlerts      Boolean  @default(true)
  webhookSilenceAlerts  Boolean  @default(true)
  silenceThresholdHours Int      @default(24)
  debounceHours         Int      @default(6)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceOpsAlertDelivery {
  id          String   @id @default(cuid())
  workspaceId String
  alertKey    String
  channel     String
  status      String
  detail      String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, alertKey, createdAt])
  @@index([workspaceId, createdAt])
}

model WorkspaceMember {
  id               String        @id @default(cuid())
  workspaceId      String
  userId           String
  role             WorkspaceRole
  canManageMembers Boolean       @default(false)
  createdAt        DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WhatsappInstance {
  id                     String                 @id @default(cuid())
  workspaceId            String
  name                   String
  provider               String
  providerInstanceId     String?
  providerTokenEncrypted String?
  providerTokenIv        String?
  providerTokenTag       String?
  configEncrypted        String?
  configIv               String?
  configTag              String?
  displayName            String?
  lastHealthCheckedAt    DateTime?
  lastHealthStatus       String?
  webhookUrl             String?
  webhookTokenHash       String?
  status                 WhatsappInstanceStatus @default(active)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  workspace             Workspace                    @relation(fields: [workspaceId], references: [id])
  leads                 Lead[]
  inboundWebhookChannel InboundWebhookChannel?
  uazapiChatLabelStates UazapiChatLabelState[]

  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([workspaceId, provider])
  @@index([providerInstanceId])
}

model UazapiChatLabelState {
  id                 String   @id @default(cuid())
  workspaceId        String
  whatsappInstanceId String
  contactKey         String
  labelIds           String[] @default([])
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  whatsappInstance WhatsappInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, whatsappInstanceId, contactKey])
  @@index([workspaceId, whatsappInstanceId])
}

model AuthSession {
  id                        String    @id @default(cuid())
  userId                    String
  activeWorkspaceId         String?
  supportWorkspaceId        String?
  supportWorkspaceStartedAt DateTime?
  refreshHash               String    @unique
  userAgent                 String?
  ipAddress                 String?
  expiresAt                 DateTime
  revokedAt                 DateTime?
  createdAt                 DateTime  @default(now())

  user             User       @relation(fields: [userId], references: [id])
  activeWorkspace  Workspace? @relation("AuthSessionActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  supportWorkspace Workspace? @relation("AuthSessionSupportWorkspace", fields: [supportWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, activeWorkspaceId])
  @@index([activeWorkspaceId])
  @@index([supportWorkspaceId])
}

model AuthActionToken {
  id          String              @id @default(cuid())
  userId      String
  workspaceId String?
  type        AuthActionTokenType
  tokenHash   String              @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime            @default(now())

  user      User       @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, type, usedAt])
  @@index([workspaceId, type, usedAt])
  @@index([type, expiresAt])
}


model WorkspaceInvite {
  id          String                @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  status      WorkspaceInviteStatus @default(pending)
  tokenHash   String                @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, email])
}

model WebhookLog {
  id                 String           @id @default(cuid())
  workspaceId        String?
  whatsappInstanceId String?
  source             DiagnosticSource
  eventType          String
  externalEventId    String?
  status             String
  receivedAt         DateTime         @default(now())
  processedAt        DateTime?
  leadId             String?
  phoneHash          String?
  campaignId         String?
  adSetId            String?
  adId               String?
  jobId              String?
  errorCode          String?
  errorMessage       String?
  summaryPayload     Json?
  rawPayloadRef      String?
  idempotencyKey     String?          @unique
  payloadHash        String?

  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  diagnosticEvents DiagnosticEvent[]

  @@index([workspaceId, source, status, receivedAt])
  @@index([workspaceId, whatsappInstanceId, receivedAt])
}

model IntegrationLog {
  id                   String           @id @default(cuid())
  workspaceId          String?
  source               DiagnosticSource
  operation            String
  status               String
  startedAt            DateTime         @default(now())
  finishedAt           DateTime?
  durationMs           Int?
  requestSummary       Json?
  responseSummary      Json?
  httpStatus           Int?
  providerRequestId    String?
  providerErrorCode    String?
  providerErrorMessage String?
  leadId               String?
  campaignId           String?
  adSetId              String?
  adId                 String?
  jobId                String?

  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  diagnosticEvents DiagnosticEvent[]

  @@index([workspaceId, source, status, startedAt])
  @@index([providerRequestId])
}

model ConversionEventLog {
  id                          String    @id @default(cuid())
  workspaceId                 String?
  leadId                      String?
  phoneHash                   String?
  sourceTrigger               String
  eventName                   String
  status                      String
  pixelId                     String?
  pageId                      String?
  eventId                     String?
  metaAccountId               String?
  campaignId                  String?
  adSetId                     String?
  adId                        String?
  ctwaClid                    String?
  attributionStatus           String?
  dedupeKey                   String?   @unique
  eventOccurredAt             DateTime  @default(now())
  customerIdentityKey         String?
  businessSource              String    @default("paid")
  purchaseKind                String?
  valueSource                 String?
  externalConnectorId         String?
  sourceEventId               String?
  sentAt                      DateTime?
  sourcePayload               Json?
  providerRequestPayload      Json?
  providerResponseSummary     Json?
  customData                  Json?
  valueCents                  Int?
  currency                    String?
  contentName                 String?
  errorCode                   String?
  errorMessage                String?
  jobId                       String?
  metaBusinessConnectionId    String?
  metaConversionDestinationId String?
  createdAt                   DateTime  @default(now())

  workspace                 Workspace?                 @relation(fields: [workspaceId], references: [id])
  externalConnector         ExternalDataConnector?     @relation(fields: [externalConnectorId], references: [id], onDelete: SetNull)
  purchaseReview            PurchaseReview?
  purchaseValueAdjustments  PurchaseValueAdjustment[]
  metaBusinessConnection    MetaBusinessConnection?    @relation(fields: [metaBusinessConnectionId], references: [id], onDelete: SetNull)
  metaConversionDestination MetaConversionDestination? @relation(fields: [metaConversionDestinationId], references: [id], onDelete: SetNull)
  diagnosticEvents          DiagnosticEvent[]
  purchaseClaims            ProviderPurchaseClaim[]
  pipedriveConversionDedupes PipedriveConversionDedupe[]

  @@unique([workspaceId, id], map: "ConversionEventLog_workspace_id_key")
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, eventOccurredAt])
  @@index([workspaceId, eventName, eventOccurredAt])
  @@index([workspaceId, adId])
  @@index([workspaceId, metaBusinessConnectionId])
  @@index([workspaceId, metaConversionDestinationId])
  @@index([leadId])
  @@index([externalConnectorId, sourceEventId])
}

model ExternalDataConnector {
  id                        String    @id @default(cuid())
  workspaceId               String
  name                      String
  provider                  String
  status                    String    @default("draft")
  timezone                  String    @default("America/Sao_Paulo")
  sslMode                   String    @default("required")
  credentialsEncrypted      String
  credentialsIv             String
  credentialsTag            String
  syncEnabled               Boolean   @default(false)
  shadowMode                Boolean   @default(true)
  capiSendEnabled           Boolean   @default(false)
  purchaseAverageValueCents Int?
  defaultCurrency           String?   @default("BRL")
  lastConnectionTestAt      DateTime?
  lastConnectionStatus      String?
  lastSyncStartedAt         DateTime?
  lastSyncCompletedAt       DateTime?
  lastSyncStatus            String?
  lastSyncErrorCode         String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cursors          ExternalSyncCursor[]
  ingestionRecords ExternalIngestionRecord[]
  conversionEvents ConversionEventLog[]
  capiCutovers     ExternalCapiCutover[]

  @@index([workspaceId, status])
  @@index([syncEnabled, status, updatedAt])
}

model ExternalCapiCutover {
  id                 String    @id @default(cuid())
  workspaceId        String
  connectorId        String
  eventType          String
  status             String    @default("active")
  activatedAt        DateTime
  activatedByUserId  String
  shadowArchivedRows Int       @default(0)
  rolledBackAt       DateTime?
  rolledBackByUserId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  connector ExternalDataConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, status])
  @@index([workspaceId, eventType, activatedAt])
}

model ExternalSyncCursor {
  id             String    @id @default(cuid())
  connectorId    String
  stream         String
  lastExternalId String?
  lastUpdatedAt  DateTime?
  lastSyncedAt   DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connector ExternalDataConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, stream])
  @@index([connectorId, lastSyncedAt])
}

model ExternalIngestionRecord {
  id                   String    @id @default(cuid())
  workspaceId          String
  connectorId          String
  stream               String
  externalRowId        String
  dedupeKey            String    @unique
  eventType            String?
  status               String
  occurredAt           DateTime?
  leadId               String?
  conversionEventLogId String?
  duplicateCount       Int       @default(0)
  errorCode            String?
  errorMessage         String?
  summaryPayload       Json?
  firstReceivedAt      DateTime  @default(now())
  lastReceivedAt       DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connector ExternalDataConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, stream, externalRowId])
  @@index([workspaceId, status, occurredAt])
  @@index([conversionEventLogId])
}

model JobAttempt {
  id                String           @id @default(cuid())
  workspaceId       String?
  queueName         String
  jobId             String
  jobName           String
  attemptNumber     Int
  status            String
  scheduledAt       DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  nextRetryAt       DateTime?
  source            DiagnosticSource
  relatedEntityType String?
  relatedEntityId   String?
  errorCode         String?
  errorMessage      String?
  summaryPayload    Json?
  createdAt         DateTime         @default(now())

  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  diagnosticEvents DiagnosticEvent[]

  @@index([workspaceId, source, status, createdAt])
  @@index([jobId])
}

model DiagnosticEvent {
  id                   String             @id @default(cuid())
  workspaceId          String?
  source               DiagnosticSource
  eventType            String
  severity             DiagnosticSeverity
  status               String
  occurredAt           DateTime           @default(now())
  title                String
  message              String
  leadId               String?
  phoneHash            String?
  campaignId           String?
  adSetId              String?
  adId                 String?
  jobId                String?
  errorCode            String?
  summaryPayload       Json?
  webhookLogId         String?
  integrationLogId     String?
  conversionEventLogId String?
  jobAttemptId         String?
  createdAt            DateTime           @default(now())

  workspace          Workspace?          @relation(fields: [workspaceId], references: [id])
  webhookLog         WebhookLog?         @relation(fields: [webhookLogId], references: [id])
  integrationLog     IntegrationLog?     @relation(fields: [integrationLogId], references: [id])
  conversionEventLog ConversionEventLog? @relation(fields: [conversionEventLogId], references: [id])
  jobAttempt         JobAttempt?         @relation(fields: [jobAttemptId], references: [id])

  @@index([workspaceId, source, status, occurredAt])
  @@index([workspaceId, severity, occurredAt])
  @@index([eventType])
  @@index([leadId])
  @@index([phoneHash])
  @@index([campaignId])
  @@index([adSetId])
  @@index([adId])
  @@index([jobId])
}

model AuditLog {
  id            String   @id @default(cuid())
  workspaceId   String?
  actorUserId   String?
  actorType     String
  action        String
  targetType    String
  targetId      String
  reason        String?
  sourceIp      String?
  resultStatus  String
  beforeSummary Json?
  afterSummary  Json?
  createdAt     DateTime @default(now())


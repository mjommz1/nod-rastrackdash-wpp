enum XmaxAccountStatus {
  active
  paused
  disabled
}

enum XmaxShadowEventStatus {
  observed
  discarded
  duplicate
  failed
}

/// One row per XMAX tenant webhook (today: 1 for Dr. Hernia). Global ingress
/// auth boundary — routing to XmaxAccount happens only after this passes.

/// XMAX multi-account integration (shadow ingest first; no CAPI in X1).

/// Semantic dedup: 1 event per contact+eventName forever (tag re-add must not re-fire).

/// Shadow observation log for XMAX webhook processing (no Meta send in X1).

enum LicenseInterval {
  annual
  monthly
  semiannual
}

enum LicenseStatus {
  active
  refunded
  chargeback
  revoked
}

enum LicenseHeartbeatStatus {
  ok
  stale
}

/// RastrackDash license server (PalmUP). Raw key is never persisted after issue.
/// Expiry is derived from expiresAt at validation time; it is not a stored status.

/// Short-lived encrypted copy of the raw key (7d TTL) so admin resend can redeliver
/// without ever storing the raw key in the License row itself.

/// Telemetry of student instances. Unlimited fingerprints for the same bound account.

/// Idempotent Guru (and future provider) webhook audit. Invalid signatures must not mutate License.

/// Local (client-side) runtime state for the license-client module (F4.1). Single row keyed by
/// `id = "singleton"`. Populated by talking to the private PalmUP license server over HTTP; this
/// public template contains no license-server logic itself. `status` is intentionally a plain
/// string ("active" | "grace" | "blocked" | "unlicensed") rather than a DB enum so the client can
/// evolve independently of the (private) server's own License/LicenseStatus vocabulary above.
model LicenseState {
  id               String    @id @default("singleton")
  fingerprint      String
  accountIdentity  String
  licenseKeyPrefix String
  signedCache      String?   @db.Text
  cacheValidUntil  DateTime?
  lastCheckedAt    DateTime?
  lastError        String?   @db.Text
  status           String    @default("unlicensed")
  expiresAt        DateTime?
  bound            Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Kommo credentials are AEAD-encrypted server-side. Account identity is
/// verified from the remote API, never accepted from a management request.
model KommoConnection {
  id                    String   @id
  workspaceId           String
  displayName           String
  status                String   @default("blocked")
  accountOrigin         String
  verifiedAccountId     String?
  accountSubdomain      String?
  accessTokenEncrypted  String
  accessTokenIv         String
  accessTokenTag        String
  credentialHealthy     Boolean  @default(false)
  credentialGeneration  Int      @default(1)
  allowedChannelRouteIds String[] @default([])
  catalogState          String   @default("empty")
  catalogRefreshedAt    DateTime?
  lastErrorCode         String?
  webhookSecretHash     String   @unique
  webhookSecretVersion  Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  pipelines KommoPipelineCatalog[]
  rules     KommoConversionRule[]
  events    KommoWebhookEvent[]

  @@unique([workspaceId, verifiedAccountId])
  @@index([workspaceId, status])
}

model KommoPipelineCatalog {
  id           String   @id @default(cuid())
  workspaceId  String
  connectionId String
  pipelineId   String
  pipelineName String
  pipelineSort Int?
  statusId     String
  statusName   String
  statusType   String?
  available    Boolean  @default(true)
  refreshedAt  DateTime @default(now())

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  connection KommoConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([connectionId, pipelineId, statusId])
  @@index([connectionId, available])
  @@index([workspaceId, connectionId])
}

/// Dedicated Pipedrive credentials: only AEAD ciphertext, IV and tag are
/// persisted. Identity must be verified upstream; generation fences stale
/// credential/catalog responses.
model PipedriveConnection {
  id                     String    @id
  workspaceId            String
  displayName            String
  status                 String    @default("blocked")
  accountOrigin          String
  verifiedAccountId      String?
  accountSubdomain       String?
  accessTokenEncrypted   String
  accessTokenIv          String
  accessTokenTag         String
  credentialHealthy      Boolean   @default(false)
  credentialGeneration   Int       @default(1)
  allowedChannelRouteIds String[]  @default([])
  credentialActivatedAt  DateTime  @default(now())
  webhookSecretHash      String?   @unique
  webhookSecretVersion   Int       @default(0)
  webhookIssuedAt        DateTime?
  webhookRateWindowAt    DateTime?
  webhookRateCount       Int       @default(0)
  webhookLastReceivedAt  DateTime?
  mutationRevision       Int       @default(0)
  catalogState           String    @default("empty")
  catalogRefreshedAt     DateTime?
  lastErrorCode          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pipelines PipedrivePipelineCatalog[]
  rules     PipedriveConversionRule[]
  events    PipedriveWebhookEvent[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, verifiedAccountId])
  @@index([workspaceId, status])
}

/// One row per upstream pipeline, including pipelines with zero stages.
model PipedrivePipelineCatalog {
  id           String   @id @default(cuid())
  workspaceId  String
  connectionId String
  pipelineId   String
  pipelineName String
  pipelineSort Int?
  available    Boolean  @default(true)
  refreshedAt  DateTime @default(now())

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection PipedriveConnection     @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  stages     PipedriveStageCatalog[]

  @@unique([connectionId, pipelineId])
  @@unique([connectionId, workspaceId, pipelineId])
  @@index([workspaceId, connectionId])
  @@index([connectionId, available])
}

/// Composite ownership key ties a stage to its exact connection, workspace
/// and pipeline.
model PipedriveStageCatalog {
  id           String   @id @default(cuid())
  workspaceId  String
  connectionId String
  pipelineId   String
  stageId      String
  stageName    String
  stageSort    Int?
  available    Boolean  @default(true)
  refreshedAt  DateTime @default(now())

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pipeline  PipedrivePipelineCatalog @relation(fields: [connectionId, workspaceId, pipelineId], references: [connectionId, workspaceId, pipelineId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([connectionId, pipelineId, stageId])
  @@index([workspaceId, connectionId])
  @@index([connectionId, pipelineId, available])
}

/// trigger "stage_change" requires stageId; "deal_won" has no stage, always
/// Purchase, and is unique per pipeline (partial SQL index). Production
/// activation is fenced by productionActivatedAt.
model PipedriveConversionRule {
  id                    String    @id @default(cuid())
  workspaceId           String
  connectionId          String
  name                  String
  trigger               String    @default("stage_change")
  pipelineId            String
  stageId               String?
  eventName             String
  mode                  String    @default("observation")
  productionActivatedAt DateTime?
  valueMode             String    @default("deal")
  fixedValueCents       Int?
  currency              String?
  contentName           String?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection PipedriveConnection @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([connectionId, pipelineId, stageId, eventName])
  @@index([workspaceId, connectionId, active])
}

/// Durable inbox: reduced typed facts only, never the raw webhook/person/phone.
/// changeKind is the parser classification: stage_change, deal_won, deal_lost
/// (recorded only, never converts) or ignored (custom field/other edits).
model PipedriveWebhookEvent {
  id                   String    @id @default(cuid())
  workspaceId          String
  connectionId         String
  deliveryKey          String
  verifiedAccountId    String
  accountSubdomain     String
  credentialGeneration Int
  webhookSecretVersion Int
  changeKind           String    @default("ignored")
  dealId               String?
  pipelineId           String?
  stageId              String?
  oldStageId           String?
  dealStatus           String?
  previousDealStatus   String?
  personId             String?
  occurredAt           DateTime
  valueCents           BigInt?
  valuePresent         Boolean   @default(false)
  currency             String?
  status               String    @default("received")
  errorCode            String?
  attempts             Int       @default(0)
  nextAttemptAt        DateTime?
  leaseToken           String?
  leaseExpiresAt       DateTime?
  matchedLeadId        String?
  matchedRouteId       String?
  results              Json      @default("[]")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection  PipedriveConnection         @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  matchedLead Lead?                       @relation(fields: [workspaceId, matchedLeadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  dedupes     PipedriveConversionDedupe[]

  @@unique([connectionId, deliveryKey])
  @@unique([id, workspaceId, verifiedAccountId, dealId])
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([workspaceId, connectionId, createdAt])
  @@index([workspaceId, verifiedAccountId, dealId, occurredAt])
}

/// Separate observation and production fences per deal + event. Production
/// publication is a durable outbox; sender claims never expire when remote
/// delivery may be unknown.
model PipedriveConversionDedupe {
  id                        String    @id @default(cuid())
  workspaceId               String
  verifiedAccountId         String
  dealId                    String
  eventName                 String
  mode                      String    @default("observation")
  sourceEventId             String
  conversionEventLogId      String?
  publicationIntent         Json?
  publicationStatus         String    @default("observed")
  publicationAttempts       Int       @default(0)
  publicationNextAttemptAt  DateTime?
  publicationLeaseToken     String?
  publicationLeaseExpiresAt DateTime?
  publicationErrorCode      String?
  senderAttempts            Int       @default(0)
  senderRetryable           Boolean   @default(false)
  senderLeaseToken          String?
  createdAt                 DateTime  @default(now())

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceEvent        PipedriveWebhookEvent @relation(fields: [sourceEventId, workspaceId, verifiedAccountId, dealId], references: [id, workspaceId, verifiedAccountId, dealId], onDelete: Restrict, onUpdate: Restrict)
  conversionEventLog ConversionEventLog?   @relation(fields: [workspaceId, conversionEventLogId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, verifiedAccountId, dealId, eventName, mode], map: "PipedriveConversionDedupe_semantic_mode_key")
  @@index([workspaceId, sourceEventId])
  @@index([publicationStatus, publicationNextAttemptAt], map: "PipedriveConversionDedupe_publication_idx")
  @@index([workspaceId, conversionEventLogId], map: "PipedriveConversionDedupe_conversion_idx")
}

model KommoConversionRule {
  id              String   @id @default(cuid())
  workspaceId     String
  connectionId    String
  name            String
  pipelineId      String
  statusId        String
  eventName       String
  mode            String   @default("observation")
  valueMode       String   @default("lead_price")
  fixedValueCents Int?
  currency        String?
  contentName     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  connection KommoConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([connectionId, pipelineId, statusId, eventName])
  @@index([workspaceId, connectionId, active])
}

/// Durable ingress record. The delivery key is transport-level only; semantic
/// conversion idempotency lives in KommoConversionDedupe below.
model KommoWebhookEvent {
  id                   String   @id @default(cuid())
  workspaceId          String
  connectionId         String
  verifiedAccountId    String
  credentialGeneration Int      @default(1)
  deliveryKey          String   @unique
  dealId               String
  pipelineId           String
  statusId             String
  oldStatusId          String?
  eventOccurredAt      DateTime
  eventPriceCents      Int?
  eventPricePresent    Boolean  @default(false)
  status               String   @default("accepted")
  errorCode            String?
  attempts             Int      @default(0)
  jobId                String?
  matchedLeadId        String?
  conversionEventLogId String?
  processedAt          DateTime?
  revision             Int      @default(0)
  leaseToken           String?
  leaseExpiresAt       DateTime?
  nextAttemptAt        DateTime?
  results              Json     @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  connection KommoConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, createdAt])
  @@index([connectionId, dealId])
}

/// Semantic conversion fence: a rule edit, duplicate delivery, or reconnect
/// cannot create a second conversion for the same verified deal and event.
model KommoConversionDedupe {
  id                        String   @id @default(cuid())
  workspaceId               String
  verifiedAccountId         String
  dealId                    String
  eventName                 String
  sourceEventId             String
  conversionEventLogId      String?
  publicationIntent         Json?
  publicationStatus         String   @default("materialized")
  publicationAttempts       Int      @default(0)
  publicationNextAttemptAt  DateTime?
  publicationLeaseToken     String?
  publicationLeaseExpiresAt DateTime?
  publicationErrorCode      String?
  senderAttempts            Int      @default(0)
  senderRetryable           Boolean  @default(false)
  senderLeaseToken          String?
  createdAt                 DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, verifiedAccountId, dealId, eventName])
  @@index([workspaceId, sourceEventId])
  @@index([publicationStatus, publicationNextAttemptAt])
}

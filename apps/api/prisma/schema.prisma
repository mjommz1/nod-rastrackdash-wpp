enum IntegrationEndpointKind {
  sales_platform
  automation_event
}

/// Fase 5.3: URL única de uma integração no workspace. Plataforma de venda
/// (Payt): uma URL por workspace; o evento vem do payload. Automação
/// (Unnichat/Umbler): uma URL por evento, válida para todos os números. O
/// roteador entrega cada callback ao processamento da regra dona.
model IntegrationEndpoint {
  id               String                  @id @default(cuid())
  workspaceId      String
  provider         InboundWebhookProvider
  kind             IntegrationEndpointKind
  /// Evento fixo da URL (automation_event); null na plataforma de venda.
  eventName        String?
  parserReleaseId  String
  /// sha256 do token; a URL pública compara em tempo constante.
  secretHash       String
  /// Token cifrado (AES-GCM, chave dos payloads) para reexibir a URL com auditoria.
  secretCiphertext String
  secretIv         String
  secretTag        String
  secretKeyVersion Int
  secretVersion    Int                     @default(1)
  lastDeliveryAt   DateTime?
  lastRoutedAt     DateTime?
  rotatedAt        DateTime?
  removedAt        DateTime?
  createdByUserId  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  workspace     Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  parserRelease InboundWebhookParserRelease @relation(fields: [parserReleaseId], references: [id], onDelete: Restrict)
  createdBy     User?                       @relation("IntegrationEndpointCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deliveries    InboundWebhookDelivery[]
  events        IntegrationEndpointEvent[]

  @@unique([workspaceId, id])
  @@index([workspaceId, provider, removedAt])
  @@index([parserReleaseId])
  @@index([createdByUserId])
}

/// Fase 5.3: recibo idempotente de cada evento recebido por uma URL única,
/// com o produto visto (produtos detectados) e o destino ou o motivo (vendas
/// sem atribuição). routed* são referências de exibição, sem FK.
model IntegrationEndpointEvent {
  id                    String                 @id @default(cuid())
  workspaceId           String
  integrationEndpointId String
  provider              InboundWebhookProvider
  ingressKey            String
  externalKey           String?
  eventName             String?
  providerStatus        String?
  /// pending | routed | unattributed | ignored | invalid
  status                String
  reasonCode            String?
  productCode           String?
  productName           String?
  offerCode             String?
  offerName             String?
  valueCents            Int?
  currency              String?
  contactIdentityHash   String?
  occurredAt            DateTime?
  firstReceivedAt       DateTime               @default(now())
  lastReceivedAt        DateTime               @default(now())
  attemptCount          Int                    @default(1)
  routedProviderRuleId  String?
  routedDeliveryId      String?
  routedChannelId       String?
  routingOutcome        String?
  encryptedPayload      String?
  payloadIv             String?
  payloadTag            String?
  encryptionKeyVersion  Int?
  payloadExpiresAt      DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  integrationEndpoint IntegrationEndpoint @relation(fields: [workspaceId, integrationEndpointId], references: [workspaceId, id], onDelete: Restrict, map: "IntegrationEndpointEvent_integrationEndpointId_fkey")

  @@unique([workspaceId, id])
  @@unique([integrationEndpointId, ingressKey], map: "IntegrationEndpointEvent_endpoint_ingress_key")
  @@index([workspaceId, status, lastReceivedAt])
  @@index([workspaceId, provider, productCode])
  @@index([payloadExpiresAt])
}


/// Cotação PTAX do Banco Central (venda, boletim de fechamento do dia):
/// 1 baseCurrency = rate quoteCurrency. Hoje só USD e EUR contra BRL; USD<->EUR
/// passa por BRL. Só é preenchida com PTAX_SYNC_ENABLED ligada (Fase 5.2).
model ExchangeRate {
  id            String       @id @default(cuid())
  /// Dia do boletim (dia útil, horário de Brasília).
  date          DateTime     @db.Date
